# Resend config for contact form (https://resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx

# Sender: must be on a domain verified in Resend (metalbarns.in)
RESEND_FROM=MBI Website <website@metalbarns.in>

# Where to deliver the enquiry emails: comma-separated, any number of addresses
# (defaults to avijit@ and jaya@metalbarns.in)
CONTACT_TO=avijit@metalbarns.in,jaya@metalbarns.in
